          "addressRegion": "Нижегородская область",
          "postalCode": "603000",
          "addressCountry": "RU"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 56.294,
          "longitude": 43.936
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "19:00"
          }
        ],
        "medicalSpecialty": "Prosthodontics",
        "memberOf": [
          {
            "@type": "MedicalClinic",
            "name": "Стоматологическая клиника",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "ул. Октябрьской Революции, д. 43",
              "addressLocality": "Нижний Новгород",
              "addressCountry": "RU"
            }
          }
        ],
        "physician": { "@id": "https://ortopednn.ru/#doctor" },
        "areaServed": {
          "@type": "City",
          "name": "Нижний Новгород",
          "containedInPlace": {
            "@type": "State",
            "name": "Нижегородская область"
          }
        },
        "sameAs": [
          "https://t.me/nikitina_ortoped"
        ]
      },
      {
        "@type": "Physician",
        "@id": "https://ortopednn.ru/#doctor",
        "name": "Никитина Марина Георгиевна",
        "description": "Стоматолог-ортопед с 1994 года",
        "medicalSpecialty": "Prosthodontics",
        "worksFor": { "@id": "https://ortopednn.ru/#clinic" },
        "url": "https://ortopednn.ru/about/",
        "telephone": "+79202537317",
        "image": "https://ortopednn.ru/og-image.svg",
        "sameAs": [
          "https://t.me/nikitina_ortoped"
        ]
      }
    ]
  })}/>

  {isHomepage && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Больно ли обтачивать зубы под коронку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Работаем с анестезией — вы не почувствуете боли. После процедуры возможна чувствительность на 1-2 дня."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько времени занимает протезирование?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Коронки — 7-14 дней. Съёмные протезы — 2-3 недели. Зависит от сложности."
          }
        },
        {
          "@type": "Question",
          "name": "Какой протез лучше — съёмный или на имплантах?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Импланты комфортнее и долговечнее. Но съёмные подходят, когда имплантация невозможна."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли обтачивать здоровые зубы?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сохраняем здоровые зубы. Обточка нужна только для фиксации коронки."
          }
        },
        {
          "@type": "Question",
          "name": "Как ухаживать за съёмным протезом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Промывайте после еды, чистите 2 раза в день, храните в воде. Раз в полгода — профчистка."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько служит циркониевая коронка?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "15-20 лет при правильном уходе. Раз в год — осмотр."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если протез натирает?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Запишитесь на коррекцию. Обычно 1-3 визита. Не подтачивайте сами."
          }
        },
        {
          "@type": "Question",
          "name": "Как понять, что пора менять коронку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Боль, отёк, подвижность, изменение цвета десны, запах — повод обратиться."
          }
        }
      ]
    })}/>
  )}

  {hasBreadcrumbs && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url
      }))
    })}/>
  )}

</head>
<body>
  <a class="skip-link" href="#main">К содержанию</a>
  <slot/>
  <footer class="legal-disclaimer">
