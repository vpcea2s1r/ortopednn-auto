---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { glossary, glossaryGroups } from '../../../data/glossary.ts';
import doctor from '../../../data/doctor.json';
import socials from '../../../data/socials.json';

const byGroup = glossaryGroups.map(g => ({
  name: g,
  items: glossary.filter(t => t.group === g),
}));
---

<BaseLayout
  title="Глоссарий стоматолога-ортопеда: термины протезирования | Никитина М.Г."
  description="Словарь терминов протезирования зубов: коронка, мост, винир, вкладка, абатмент, имплант, съёмные и бюгельные протезы. Простые определения от стоматолога-ортопеда Никитиной М.Г."
  breadcrumbTitle="Глоссарий"
  doctor={doctor}
  socials={socials}
>
  <Navbar />
  <main id="main" class="container container--w800">
    <nav class="breadcrumbs">
      <a href="/blog">Блог</a>
      <span>/</span>
      <span>Глоссарий</span>
    </nav>

    <h1>Глоссарий терминов протезирования</h1>
    <p class="lead">Короткие определения основных терминов стоматологической ортопедии. По каждому термину — подробная статья.</p>

    {byGroup.map(group => (
      <section class="group">
        <h2>{group.name}</h2>
        {group.items.map(t => (
          <div class="term">
            <div class="term__name">{t.term}</div>
            <p class="term__def">{t.def}</p>
            {t.slug && <a class="term__link" href={`/blog/${t.slug}/`}>Подробнее →</a>}
          </div>
        ))}
      </section>
    ))}

    <div class="cta">
      <p>Не нашли свой термин или нужна консультация? Запишитесь к стоматологу-ортопеду в Нижнем Новгороде.</p>
      <a href="tel:+79202537317" class="btn">+7 (920) 253-73-17</a>
    </div>
  </main>
</BaseLayout>

<style>
  .breadcrumbs { font-size: 0.85rem; margin-bottom: 1rem; color: #7a9ab8; }
  .breadcrumbs a { color: var(--color-primary); text-decoration: none; }
  .breadcrumbs span { margin: 0 0.4rem; color: #ccc; }
  h1 { color: var(--color-text); margin-bottom: 0.5rem; font-size: 1.75rem; }
  .lead { color: var(--color-text-muted); line-height: 1.7; margin-bottom: 2rem; background: var(--color-bg-alt); padding: 1rem; border-radius: 8px; }
  .group { background: white; border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  .group h2 { color: var(--color-primary); margin: 0 0 1rem; font-size: 1.25rem; }
  .term { padding: 0.75rem 0; border-bottom: 1px solid #e5e7eb; }
  .term:last-child { border-bottom: none; }
  .term__name { font-weight: 700; color: var(--color-text); margin-bottom: 0.25rem; }
  .term__def { color: var(--color-text-muted); line-height: 1.6; margin: 0 0 0.25rem; font-size: 0.95rem; }
  .term__link { color: var(--color-primary); text-decoration: none; font-size: 0.85rem; font-weight: 600; }
  .term__link:hover { text-decoration: underline; }
  .cta { text-align: center; padding: 1.5rem; background: var(--color-bg-alt); border-radius: 8px; margin-top: 1rem; }
  .cta p { margin-bottom: 1rem; color: var(--color-text); }
  .btn { display: inline-block; background: var(--color-primary); color: white; padding: 0.75rem 2rem; border-radius: var(--radius-full); text-decoration: none; font-weight: 600; }
</style>