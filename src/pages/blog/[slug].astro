---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import { getRelatedServices } from '../../../data/cross-links';
import doctor from '../../../data/doctor.json';
import socials from '../../../data/socials.json';
import { getCategory, getRelatedArticles } from '../../../data/blog-articles.ts';
import { glossary } from '../../../data/glossary.ts';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

export interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { data } = entry;
const slug = data.slug;
const pageUrl = `https://ortopednn.ru/blog/${slug}/`;
const category = data.category ? getCategory(data.category) : undefined;
const related = getRelatedArticles(slug, 3);
const body = entry.body.trim();

// Термины глоссария, реально встречающиеся в тексте статьи (без тегов).
// ponytail: только использованные термины — на странице 5–15, не все 58.
const usedGlossary = (() => {
  const plain = body.replace(/<[^>]+>/g, ' ');
  const sorted = [...glossary].sort((a, b) => b.term.length - a.term.length);
  const found = new Set<string>();
  const used: { term: string; def: string; slug?: string }[] = [];
  for (const entry of sorted) {
    if (found.has(entry.term)) continue;
    if (plain.toLowerCase().includes(entry.term.toLowerCase())) {
      found.add(entry.term);
      used.push({ term: entry.term, def: entry.def, slug: entry.slug });
    }
  }
  return used;
})();

// Извлекаем FAQ из h3-вопросов статьи (h3 + следующий p) для FAQPage schema.
// ponytail: только вопросы с вопросительным знаком, макс. 8 — как в BaseLayout.
const faqItems = (() => {
  const blocks = [...body.matchAll(/<h3>(.*?)<\/h3>\s*<p>(.*?)<\/p>/gs)]
    .map(m => ({ q: m[1].replace(/<[^>]+>/g, '').trim(), a: m[2].replace(/<[^>]+>/g, '').trim() }))
    .filter(i => i.q.includes('?') && i.a.length > 20)
    .slice(0, 8);
  return blocks;
})();

const ldArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": data.title,
  "description": data.desc,
  "author": { "@id": "https://ortopednn.ru/#doctor" },
  "datePublished": data.date,
  "dateModified": data.date,
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  "image": "https://ortopednn.ru/og-image.svg",
  "publisher": { "@id": "https://ortopednn.ru/#clinic" }
};

const ldFaq = faqItems.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqItems.map(i => ({
        "@type": "Question",
        "name": i.q,
        "acceptedAnswer": { "@type": "Answer", "text": i.a }
      }))
    }
  : null;
---

<BaseLayout
  title={`${data.title} | Никитина М.Г.`}
  description={data.desc}
  breadcrumbTitle={data.title}
  doctor={doctor}
  socials={socials}
  datePublished={data.date}
  dateModified={data.date}
>
  <Navbar />
  <main class="container container--w800">
    <nav class="breadcrumbs">
      <a href="/blog">Блог</a>
      {category && <><span>/</span><a href={`/blog/${category.slug}`}>{category.name}</a></>}
      <span>/</span>
      <span>{data.title}</span>
    </nav>

    <article>
      <h1>{data.title}</h1>
      <div class="meta">{data.date} — Никитина М.Г., стоматолог-ортопед</div>
      <fragment set:html={body} />
    </article>

    <RelatedArticles articles={related} />
    {data.category && <RelatedServices services={getRelatedServices(slug, data.category)} />}
  </main>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(ldArticle)} />
{ldFaq && <script type="application/ld+json" set:html={JSON.stringify(ldFaq)} />}

<script type="application/json" id="glossary-data" set:html={JSON.stringify(usedGlossary)} />
<script>
  import '../../../src/scripts/glossary-tooltip.ts';
</script>

<style>
  .breadcrumbs { font-size: 0.85rem; margin-bottom: 1rem; color: #7a9ab8; }
  .breadcrumbs a { color: var(--color-primary); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs span { margin: 0 0.4rem; color: #ccc; }
  article { background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
  h1 { color: var(--color-text); margin-bottom: 0.5rem; font-size: 1.75rem; }
  .meta { color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
  article :global(.lead) { font-size: 1.1rem; color: var(--color-text); line-height: 1.7; margin-bottom: 2rem; background: var(--color-bg-alt); padding: 1rem; border-radius: 8px; }
  article :global(h2) { color: var(--color-primary); margin: 2rem 0 1rem; font-size: 1.3rem; }
  article :global(p) { color: var(--color-text-muted); line-height: 1.7; margin-bottom: 1rem; }
  article :global(ul), article :global(ol) { color: var(--color-text-muted); padding-left: 1.5rem; margin-bottom: 1rem; }
  article :global(li) { margin-bottom: 0.5rem; line-height: 1.6; }
  article :global(.table-wrap) { overflow-x: auto; margin: 1rem 0; }
  article :global(table) { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  article :global(th), article :global(td) { padding: 0.75rem; text-align: left; border-bottom: 1px solid #e5e7eb; }
  article :global(th) { background: var(--color-bg-alt); font-weight: 600; color: var(--color-text); }
  article :global(td) { color: var(--color-text-muted); }
  article :global(.cta) { text-align: center; padding: 1.5rem; background: var(--color-bg-alt); border-radius: 8px; margin-top: 2rem; }
  article :global(.cta p) { margin-bottom: 1rem; color: var(--color-text); }
  article :global(.btn) { display: inline-block; background: var(--color-primary); color: white; padding: 0.75rem 2rem; border-radius: var(--radius-full); text-decoration: none; font-weight: 600; }
  article :global(.btn:hover) { background: var(--color-primary-hover); }
  article :global(.glossary-term) { border-bottom: 1px dashed var(--color-primary); cursor: help; color: var(--color-text); }
  article :global(.glossary-term:focus) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  :global(.glossary-popup) { position: absolute; z-index: 1000; max-width: 320px; background: white; border: 1px solid var(--color-border); border-radius: 8px; box-shadow: 0 8px 30px rgba(0,0,0,0.15); padding: 0.75rem 1rem; display: none; }
  :global(.glossary-popup--visible) { display: block; }
  :global(.glossary-popup strong) { display: block; color: var(--color-text); margin-bottom: 0.25rem; }
  :global(.glossary-popup p) { color: var(--color-text-muted); font-size: 0.85rem; line-height: 1.5; margin: 0; }
  :global(.glossary-popup__link) { display: inline-block; margin-top: 0.5rem; color: var(--color-primary); font-size: 0.85rem; text-decoration: none; }
  :global(.glossary-popup__link:hover) { text-decoration: underline; }
</style>
