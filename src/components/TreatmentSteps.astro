---
const steps = [
  { num: "1", title: "Диагностика и планирование", desc: "Осмотр, рентген, сбор анамнеза. Врач оценивает состояние зубов, дёсен и прикуса, составляет план лечения." },
  { num: "2", title: "Подготовка", desc: "Лечение кариеса и каналов, удаление безнадёжных зубов, профессиональная чистка. При имплантации — установка имплантов." },
  { num: "3", title: "Снятие слепков", desc: "Обточка зубов под коронки, снятие слепков. На обточенные зубы ставят временные коронки на 7–14 дней." },
  { num: "4", title: "Примерка", desc: "Готовую коронку примеряют, проверяют посадку, смыкание с соседями и прикус. При необходимости отправляют на доработку." },
  { num: "5", title: "Фиксация", desc: "Коронку фиксируют на временный цемент на 1–2 недели, затем на постоянный." },
];
---

<section class="steps">
  <div class="container">
    <h2>Как проходит протезирование</h2>
    <p class="steps-sub">Пять этапов — от осмотра до фиксации. Сроки по каждому этапу — в статье.</p>
    <div class="steps-grid">
      {steps.map((s) => (
        <div class="step">
          <span class="step-num">{s.num}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
    <a href="/blog/etapy-protezirovaniya-zubov/" class="btn">Подробнее об этапах</a>
  </div>
</section>

<style>
.steps {
  padding: var(--space-xl) 0;
  background: white;
  border-bottom: 1px solid var(--color-border);
}

.steps h2 {
  font-size: var(--text-2xl);
  color: var(--color-text);
  margin-bottom: var(--space-xxs);
}

.steps-sub {
  color: var(--color-text-muted);
  margin-bottom: var(--space-lg);
}

.steps-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

@media (max-width: 1100px) {
  .steps-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 700px) {
  .steps-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 480px) {
  .steps-grid {
    grid-template-columns: 1fr;
  }
}

.step {
  background: #f8fafc;
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: var(--space-md);
}

.step-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-primary);
  color: white;
  font-weight: 700;
  font-size: var(--text-sm);
  margin-bottom: var(--space-xs);
}

.step h3 {
  font-size: var(--text-base);
  color: var(--color-text);
  margin-bottom: var(--space-xxs);
}

.step p {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: 1.6;
}
</style>
